<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<!--
    One message in the conversation. This is an fx:root layout rather than a
    controller-backed one: DialogBox sets itself as both root and controller,
    so each instance loads this file into itself and there is no fx:controller
    attribute naming a class here.
-->
<fx:root alignment="TOP_RIGHT"
         maxWidth="1.7976931348623157E308"
         minWidth="0.0"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" minWidth="0.0" text="Label" wrapText="true" />
        <ImageView fx:id="displayPicture" fitHeight="80.0" fitWidth="80.0"
                   pickOnBounds="true" preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
</fx:root>
